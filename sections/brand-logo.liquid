<!-- our-brand-area start -->
<section class="our-brand-logo">
  <div class="container">
  <div class="row">
    <div class="col branlogo-wrap">
      <div class="brand-logo swiper" id="brand-logo">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
          <div class="swiper-slide">
            <div class="brand-img">
              <a href="{{ block.settings.brand_url }}">
                {%- if block.settings.brand_image -%}
                {{ block.settings.brand_image | image_url: width: 500 | image_tag:
                  loading: 'lazy',
                  width: block.settings.brand_image.width,
                  height: block.settings.brand_image.height,
                  class: "img-fluid",
                  alt: block.settings.brand_image.alt | escape }}
                {%- else -%}
                {%- capture placeholder -%}collection-{% cycle 1, 2, 3, 4, 5, 6 %}{%- endcapture -%}
                {{ placeholder | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
  </div>
</section>

<!-- our-brand-area end -->
<script type="text/javascript">
  addEventListener('DOMContentLoaded', (event) => {
    var swiper = new Swiper('.swiper#brand-logo', {
      slidesPerView: 5,
      grid: {
        rows: 1,
        fill: 'row'
      },
      spaceBetween: 24,
      observer: true,
      observeParents: true,
      watchSlidesProgress: true,
      {%- if settings.enable_rtl -%}
      rtl: true,
      {%- endif -%}
      navigation: {
        nextEl: '.swiper-next-{{ section.id }}',
        prevEl: '.swiper-prev-{{ section.id }}',
      },
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
        pauseOnMouseEnter: true
      },
      breakpoints: {
        0: {
          slidesPerView: 2,
          spaceBetween: 12
        },
        480: {
          slidesPerView: 3,
          spaceBetween: 16
        },
        768: {
          slidesPerView: 4,
          spaceBetween: 20
        },
        1024: {
          slidesPerView: 5,
          spaceBetween: 24
        },
        1440: {
          slidesPerView: 6,
          spaceBetween: 28
        }
      }
    });
  });
</script>
{% schema %}
{
  "name": "Brand Logo",
  "settings": [
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "paragraph",
      "content": "Desktop / Laptop "
    },
    {
      "type": "range",
      "id": "brand_padding_top",
      "label": "Section Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "brand_padding_bottom",
      "label": "Section Padding bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "paragraph",
      "content": "Tablet"
    },
    {
      "type": "range",
      "id": "brand_padding_top_lg",
      "label": "Section Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "brand_padding_bottom_lg",
      "label": "Section Padding bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "paragraph",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "brand_padding_top_xs",
      "label": "Section Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "brand_padding_bottom_xs",
      "label": "Section Padding bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Logo styling"
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "label": "Logo max height",
      "unit": "px",
      "min": 40,
      "max": 160,
      "step": 5,
      "default": 80
    },
    {
      "type": "color",
      "id": "logo_card_background",
      "label": "Logo background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "logo_card_radius",
      "label": "Logo corner radius",
      "unit": "px",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "logo_show_shadow",
      "label": "Show card shadow",
      "default": true
    },
    {
      "type": "header",
      "content": "Background Color"
    },
    {
      "type": "color",
      "id": "brand_bgcolor",
      "label": "Background Color",
      "default": "#fff"
    },
    {
      "type": "checkbox",
      "id": "section_bg_enable",
      "label": "Section background image enable",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "section_bg_img",
      "label": "Section background image",
      "info": "Recommended Size: 1920x500px"
    }
  ],
  "blocks": [
    {
      "type": "single_brand",
      "name": "Single Brand Logo",
      "settings": [
        {
          "type": "url",
          "id": "brand_url",
          "label": "Brand Url"
        },
        {
          "type": "image_picker",
          "id": "brand_image",
          "label": "Brand Image",
          "info": "Recommended Size: 145 x 130px"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Logo",
      "category": "brand logo"
    }
  ]
}
{% endschema %}
<style>
  {% assign logo_max_height = section.settings.logo_max_height | default: 80 %}
  {% assign logo_card_radius = section.settings.logo_card_radius | default: 16 %}
  {% assign logo_card_background = section.settings.logo_card_background | default: '#ffffff' %}

  .our-brand-logo {
    padding-top:{{ section.settings.brand_padding_top }}px;
    padding-bottom:{{ section.settings.brand_padding_bottom }}px;
    background-color: {{ section.settings.brand_bgcolor }};
    {% if section.settings.section_bg_enable %}
    background-image: url({% if section.settings.section_bg_img %}{{ section.settings.section_bg_img | image_url: 'master' }}{% else %}https://dummyimage.com/1920x500/f7f7f7/999999{% endif %});
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    {% endif %}
  }
  @media (max-width: 1199px){
    .our-brand-logo {
      padding-top:{{ section.settings.brand_padding_top_lg }}px;
      padding-bottom:{{ section.settings.brand_padding_bottom_lg }}px;
    }
  }
  @media (max-width: 767px){
    .our-brand-logo {
      padding-top:{{ section.settings.brand_padding_top_xs }}px;
      padding-bottom:{{ section.settings.brand_padding_bottom_xs }}px;
    }
  }
  .our-brand-logo .branlogo-wrap{
    margin: 0 auto;
    max-width: 1120px;
  }
  .our-brand-logo .brand-logo {
    padding: 0 8px;
  }
  .our-brand-logo .brand-logo .swiper-wrapper {
    align-items: center;
  }
  .our-brand-logo .brand-logo .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 4px;
    height: calc({{ logo_max_height }}px + 40px);
  }
  .our-brand-logo .brand-logo .brand-img {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 180px;
    padding: 16px 24px;
    min-height: calc({{ logo_max_height }}px + 8px);
    background-color: {{ logo_card_background }};
    border-radius: {{ logo_card_radius }}px;
    {% if section.settings.logo_show_shadow %}
    box-shadow: 0 18px 45px rgba(17, 24, 39, 0.08);
    {% else %}
    box-shadow: none;
    {% endif %}
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .our-brand-logo .brand-logo .brand-img:hover {
    transform: translateY(-4px);
    {% if section.settings.logo_show_shadow %}
    box-shadow: 0 24px 50px rgba(17, 24, 39, 0.12);
    {% endif %}
  }
  .our-brand-logo .brand-logo .brand-img img,
  .our-brand-logo .brand-logo .brand-img svg {
    max-height: {{ logo_max_height }}px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }
  .our-brand-logo .brand-logo a img {
    opacity: .65;
    filter: grayscale(10%);
  }
  .our-brand-logo .brand-logo a svg {
    width: 100%;
  }
  .our-brand-logo .brand-logo a:hover img {
    opacity: 1;
    filter: none;
  }
  .our-brand-logo .brand-logo a img,
  .our-brand-logo .brand-logo a:hover img {
    -webkit-transition: all 0.3s ease-in-out 0s;
    -o-transition: all 0.3s ease-in-out 0s;
    transition: all 0.3s ease-in-out 0s;
  }
  @media (max-width: 767px){
    .our-brand-logo .brand-logo {
      padding: 0;
    }
    .our-brand-logo .brand-logo .brand-img {
      padding: 12px 18px;
      max-width: 160px;
      min-height: calc({{ logo_max_height }}px + 4px);
    }
    .our-brand-logo .brand-logo .swiper-slide {
      height: calc({{ logo_max_height }}px + 32px);
    }
  }
</style>