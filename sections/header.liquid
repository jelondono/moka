<style>
    .header-area{
        background-color: {{ section.settings.header_bg_color }};
    }
    {% if section.settings.header_sticky_enable %}
    {% if template == 'index' or template == 'collection' or template == 'product' %}
    /* sticky menu css */
    .is-sticky{
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 3;
        box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.15);
    }
    .header-area.is-sticky{
        animation: smoothScroll 1s forwards;
        border-bottom: none;
    }

    /* Header sticky más pequeño */
    .header-area.is-sticky .header-top {
        display: none;
    }

    .header-area.is-sticky .header-main-area {
        padding: 12px 0;
    }

    .header-area.is-sticky .header-main {
        min-height: 60px;
    }

    .header-area.is-sticky .logo-wrap img {
        max-height: 100px;
    }

    .header-area.is-sticky .main-menu > li > a {
        padding: 10px 15px;
        font-size: 15px;
    }

    /* Solo ocultar información de contacto, mantener redes sociales */
    .header-area.is-sticky .info-wrap-ul.info-lg {
        display: none;
    }

    /* NUEVO: Mostrar específicamente las redes sociales */
    .header-area.is-sticky .right-block {
        display: flex !important;
    }

    .header-area.is-sticky .header-top-wrap.right-block {
        display: flex !important;
    }

    .header-area.is-sticky .header-icon a {
        font-size: 18px;
    }

    /* Compensar altura del header sticky */
    body.sticky-header {
        padding-top: 200px !important;
    }

    .header-area.is-sticky ~ * {
        margin-top: 0;
    }

    .header-area.is-sticky {
        margin-bottom: 0;
    }

    @keyframes smoothScroll {
        0% {
            transform: translateY(-200px);
        }
        100% {
            transform: translateY(0px);
        }
    }
    {% endif %}
    {% endif %}

    .header-element.main-menu-area,
    .header-element.main-menu-area .main-navigation,
    .header-element.main-menu-area .main-navigation .megamenu-content {
        position: relative;
        overflow: visible;
    }
    .main-menu > li.menu-link--catalog {
        position: static;
    }
    .menu-link--catalog .catalog-megamenu {
        position: absolute;
        left: 0;
        right: 0;
        top: 100%;
        background-color: #ffffff;
        border-radius: 18px;
        box-shadow: 0 28px 60px rgba(15, 23, 42, 0.18);
        padding: 0;
        display: none;
        z-index: 5;
        overflow: hidden;
    }
    .menu-link--catalog.is-open .catalog-megamenu,
    .main-menu > li.menu-link--catalog:hover .catalog-megamenu,
    .main-menu > li.menu-link--catalog:focus-within .catalog-megamenu {
        display: block;
    }
    .catalog-megamenu__inner {
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 0;
        max-width: 1320px;
        margin: 0 auto;
        padding: 32px 40px;
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.25s ease, transform 0.25s ease;
    }
    .menu-link--catalog.is-open .catalog-megamenu__inner,
    .main-menu > li.menu-link--catalog:hover .catalog-megamenu__inner,
    .main-menu > li.menu-link--catalog:focus-within .catalog-megamenu__inner {
        opacity: 1;
        transform: translateY(0);
    }
    .catalog-megamenu__categories {
        padding: 8px 32px 8px 8px;
        border-right: 1px solid rgba(15, 23, 42, 0.08);
        min-width: 220px;
    }
    .catalog-category-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .catalog-category-item button {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: transparent;
        border: none;
        padding: 10px 14px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
        color: var(--color_secondary);
        transition: all 0.2s ease;
        cursor: pointer;
    }
    .catalog-category-item.active button,
    .catalog-category-item button:hover {
        background-color: rgba(0,0,0,0.05);
        color: var(--color_primary);
    }
    .catalog-megamenu__panels {
        padding: 0 0 0 40px;
        min-height: 320px;
    }
    .catalog-panel {
        display: none;
        animation: fadeIn 0.25s ease;
    }
    .catalog-panel.active {
        display: block;
    }
    .catalog-panel__header {
        margin-bottom: 24px;
    }
    .catalog-panel__title {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 24px;
        font-size: 20px;
        font-weight: 700;
        margin: 0;
        color: var(--heading_text_color);
    }
    .catalog-panel__title-text {
        display: inline-flex;
        align-items: center;
        gap: 12px;
    }
    .catalog-panel__title-text::before {
        content: '';
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: var(--color_primary);
        box-shadow: 0 0 0 6px rgba(249, 115, 22, 0.12);
    }
    .catalog-panel__see-all {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 600;
        color: var(--color_secondary);
        border-bottom: 1px solid transparent;
        transition: color 0.2s ease, border-color 0.2s ease;
    }
    .catalog-panel__see-all:hover {
        color: var(--color_primary);
        border-color: currentColor;
    }
    .catalog-panel__columns {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px,1fr));
        gap: 28px 36px;
        align-items: start;
    }
    .catalog-panel__column {
        display: flex;
        flex-direction: column;
        gap: 12px;
        min-width: 0;
    }
    .catalog-panel__column-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 4px;
    }
    .catalog-panel__column-title {
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 700;
        color: rgba(15, 23, 42, 0.7);
    }
    .catalog-panel__column-all {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: rgba(15, 23, 42, 0.55);
    }
    .catalog-panel__column-all:hover {
        color: var(--color_primary);
    }
    .catalog-panel__list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 8px;
    }
    .catalog-panel__list a,
    .catalog-panel__single,
    .catalog-panel__single-list a {
        color: rgba(15, 23, 42, 0.75);
        font-size: 14px;
        line-height: 1.4;
    }
    .catalog-panel__list a:hover,
    .catalog-panel__single:hover,
    .catalog-panel__single-list a:hover {
        color: var(--color_primary);
    }
    .catalog-panel__list--brands {
        max-height: 260px;
        overflow-y: auto;
        padding-right: 6px;
    }
    .catalog-panel__list--brands::-webkit-scrollbar {
        width: 6px;
    }
    .catalog-panel__list--brands::-webkit-scrollbar-thumb {
        background-color: rgba(15, 23, 42, 0.18);
        border-radius: 999px;
    }
    .catalog-panel__column--brands {
        min-width: 220px;
    }
    .catalog-panel__column--brands .catalog-panel__column-title {
        color: var(--color_primary);
    }
    .catalog-panel__column--brands .catalog-panel__column-header::after {
        content: '';
        flex: 1;
        height: 1px;
        margin-left: 8px;
        background: linear-gradient(to right, rgba(249, 115, 22, 0.35), rgba(249, 115, 22, 0));
    }
    .catalog-mobile-submenu {
        display: none;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @media (max-width: 1199px) {
        .catalog-megamenu__inner {
            grid-template-columns: 220px 1fr;
            padding: 28px;
            max-width: calc(100% - 32px);
        }
        .catalog-megamenu__panels {
            padding-left: 28px;
        }
    }
    @media (max-width: 991px) {
        .menu-link--catalog .catalog-megamenu {
            display: none !important;
        }
        .catalog-mobile-submenu {
            display: block;
        }
        .catalog-mobile-submenu .container.ul {
            padding: 0 20px 15px;
        }
        .catalog-mobile-category {
            padding: 12px 0;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }
        .catalog-mobile-category-title {
            display: block;
            font-weight: 700;
            font-size: 15px;
            color: var(--color_secondary);
            margin-bottom: 10px;
        }
        .catalog-mobile-columns {
            list-style: none;
            margin: 0;
            padding: 0 0 8px 18px;
            display: grid;
            gap: 12px;
        }
        .catalog-mobile-column--brands .catalog-mobile-column-list {
            max-height: 220px;
            overflow-y: auto;
        }
        .catalog-mobile-column--brands .catalog-mobile-column-title {
            color: var(--color_primary);
        }
        .catalog-mobile-column-title {
            display: block;
            font-weight: 600;
            font-size: 14px;
            color: var(--color_secondary);
            margin-left: 4px;
        }
        .catalog-mobile-column-list {
            list-style: none;
            margin: 6px 0 0 18px;
            padding: 0;
            display: grid;
            gap: 6px;
        }
        .catalog-mobile-column-list a {
            font-size: 13px;
            color: var(--color_secondary);
        }
        .catalog-mobile-column-list a:hover {
            color: var(--color_primary);
        }
    }
</style>
<script>
window.addEventListener('scroll', function() {
    var headerWrapper = document.querySelector('.header-kaj');
    if (!headerWrapper) {
        return;
    }
    if (window.scrollY > 50) {
        document.body.classList.add('sticky-header');
        headerWrapper.classList.add('is-sticky');
    } else {
        document.body.classList.remove('sticky-header');
        headerWrapper.classList.remove('is-sticky');
    }
});

document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.menu-link--catalog').forEach(function(item) {
        var megaMenu = item.querySelector('.catalog-megamenu');
        if (!megaMenu) {
            return;
        }
        var mobileMenu = item.querySelector('.catalog-mobile-submenu');

        var buttons = megaMenu.querySelectorAll('.catalog-category-trigger');
        var panels = megaMenu.querySelectorAll('.catalog-panel');

        function setActive(targetId) {
            if (!targetId) {
                return;
            }
            buttons.forEach(function(btn) {
                btn.parentElement.classList.remove('active');
                if (btn.dataset.catalogTarget === targetId) {
                    btn.parentElement.classList.add('active');
                }
            });
            panels.forEach(function(panel) {
                panel.classList.toggle('active', panel.dataset.catalogPanel === targetId);
            });
        }

        buttons.forEach(function(button) {
            var targetId = button.dataset.catalogTarget;
            ['mouseenter', 'focus'].forEach(function(evt) {
                button.addEventListener(evt, function() {
                    if (window.innerWidth > 991) {
                        setActive(targetId);
                        item.classList.add('is-open');
                    }
                });
            });
            button.addEventListener('click', function(event) {
                if (window.innerWidth > 991) {
                    event.preventDefault();
                    setActive(targetId);
                    item.classList.add('is-open');
                }
            });
        });

        var topLink = item.querySelector(':scope > a.link-title');
        if (topLink) {
            topLink.addEventListener('click', function(event) {
                if (window.innerWidth > 991) {
                    event.preventDefault();
                    item.classList.toggle('is-open');
                }
            });
        }

        item.addEventListener('mouseenter', function() {
            if (window.innerWidth > 991) {
                item.classList.add('is-open');
            }
        });
        item.addEventListener('mouseleave', function() {
            if (window.innerWidth > 991) {
                item.classList.remove('is-open');
            }
        });
        item.addEventListener('focusout', function(event) {
            if (window.innerWidth > 991 && !item.contains(event.relatedTarget)) {
                item.classList.remove('is-open');
            }
        });

        if (buttons.length > 0) {
            setActive(buttons[0].dataset.catalogTarget);
        }

        if (mobileMenu) {
            mobileMenu.querySelectorAll('.catalog-mobile-columns').forEach(function(list) {
                list.style.maxHeight = null;
            });
            mobileMenu.querySelectorAll('.catalog-mobile-category-title').forEach(function(link) {
                link.addEventListener('click', function(evt) {
                    if (window.innerWidth > 991) {
                        return;
                    }
                    var section = link.closest('.catalog-mobile-category');
                    if (!section) {
                        return;
                    }
                    var columns = section.querySelector('.catalog-mobile-columns');
                    if (!columns) {
                        return;
                    }
                    if (columns.style.maxHeight) {
                        columns.style.maxHeight = null;
                        section.classList.remove('open');
                    } else {
                        mobileMenu.querySelectorAll('.catalog-mobile-columns').forEach(function(other) {
                            other.style.maxHeight = null;
                            var parent = other.closest('.catalog-mobile-category');
                            if (parent) {
                                parent.classList.remove('open');
                            }
                        });
                        columns.style.maxHeight = columns.scrollHeight + 'px';
                        section.classList.add('open');
                    }
                    evt.preventDefault();
                });
            });
        }
    });
});
</script>