<section class="brands-directory section-ptb">
  <div class="container">
    {% if section.settings.heading != blank or section.settings.description != blank %}
    <div class="brands-directory-header">
      {% if section.settings.heading != blank %}
      <h1 class="brands-directory-title">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.description != blank %}
      <p class="brands-directory-description">{{ section.settings.description }}</p>
      {% endif %}
    </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
    <div class="featured-brands">
      {% if section.settings.featured_heading != blank %}
      <h2 class="featured-brands-title">{{ section.settings.featured_heading }}</h2>
      {% endif %}
      <div class="featured-brands-grid">
        {% for block in section.blocks %}
        {% if block.type == 'featured_brand' %}
        <article class="featured-brand-card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
          <div class="featured-brand-image">
            {{ block.settings.image | image_url: width: 320 | image_tag: loading: 'lazy', class: 'img-fluid', alt: block.settings.title | escape }}
          </div>
          {% endif %}
          <div class="featured-brand-content">
            {% assign target_url = block.settings.link %}
            {% if target_url == blank and block.settings.title != blank %}
              {% assign target_url = '/collections/vendors?q=' | append: block.settings.title | url_encode %}
            {% endif %}
            {% if block.settings.title != blank %}
            <h3 class="featured-brand-name">
              {% if target_url != blank %}
              <a href="{{ target_url }}">{{ block.settings.title }}</a>
              {% else %}
              {{ block.settings.title }}
              {% endif %}
            </h3>
            {% endif %}
            {% if block.settings.subtitle != blank %}
            <p class="featured-brand-subtitle">{{ block.settings.subtitle }}</p>
            {% endif %}
            {% if block.settings.description != blank %}
            <p class="featured-brand-description">{{ block.settings.description }}</p>
            {% endif %}
            {% if target_url != blank and block.settings.button_label != blank %}
            <a href="{{ target_url }}" class="brand-button">{{ block.settings.button_label }}</a>
            {% endif %}
          </div>
        </article>
        {% endif %}
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% assign vendors = shop.vendors | sort %}
    {% if vendors.size > 0 %}
    {% assign letter_tracker = '' %}
    {% for vendor in vendors %}
      {% assign letter = vendor | slice: 0 | upcase %}
      {% unless letter >= 'A' and letter <= 'Z' %}
        {% assign letter = '#' %}
      {% endunless %}
      {% assign token = '|' | append: letter | append: '|' %}
      {% unless letter_tracker contains token %}
        {% assign letter_tracker = letter_tracker | append: letter | append: '|' %}
      {% endunless %}
    {% endfor %}

    {% assign letters_array = letter_tracker | split: '|' %}

    <div class="brands-directory-body">
      <div class="brand-index">
        <span class="brand-index-label">{{ section.settings.index_label }}</span>
        <div class="brand-index-links">
          {% for letter in letters_array %}
            {% if letter != '' %}
              {% if letter == '#' %}
                {% assign letter_text = section.settings.other_label | default: 'Otros' %}
              {% else %}
                {% assign letter_text = letter %}
              {% endif %}
              <a href="#brand-letter-{{ letter_text | handle }}" class="brand-index-link">{{ letter_text }}</a>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="brand-groups">
        {% assign current_letter = '' %}
        {% for vendor in vendors %}
          {% assign letter = vendor | slice: 0 | upcase %}
          {% unless letter >= 'A' and letter <= 'Z' %}
            {% assign letter = '#' %}
          {% endunless %}
          {% if letter != current_letter %}
            {% unless current_letter == '' %}
              </ul>
            </div>
            {% endunless %}
            {% if letter == '#' %}
              {% assign group_title = section.settings.other_label | default: 'Otros' %}
            {% else %}
              {% assign group_title = letter %}
            {% endif %}
            <div class="brand-group" id="brand-letter-{{ group_title | handle }}">
              <h2 class="brand-group-title">{{ group_title }}</h2>
              <ul class="brand-list">
            {% assign current_letter = letter %}
          {% endif %}
          <li class="brand-item">
            <a href="/collections/vendors?q={{ vendor | url_encode }}">{{ vendor }}</a>
          </li>
          {% if forloop.last %}
              </ul>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    {% else %}
    <p class="brands-directory-empty">{{ section.settings.empty_label }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Página de marcas",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Marcas"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción"
    },
    {
      "type": "text",
      "id": "featured_heading",
      "label": "Título de marcas destacadas",
      "default": "Marcas destacadas"
    },
    {
      "type": "text",
      "id": "index_label",
      "label": "Etiqueta del índice",
      "default": "Buscar por letra"
    },
    {
      "type": "text",
      "id": "other_label",
      "label": "Etiqueta para otros caracteres",
      "default": "Otros"
    },
    {
      "type": "text",
      "id": "empty_label",
      "label": "Texto cuando no hay marcas",
      "default": "No hay marcas disponibles por el momento."
    }
  ],
  "blocks": [
    {
      "type": "featured_brand",
      "name": "Marca destacada",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nombre de la marca"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Etiqueta superior"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descripción"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón",
          "default": "Ver productos"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace personalizado"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Página de marcas",
      "category": "Página"
    }
  ]
}
{% endschema %}

<style>
  .brands-directory {
    background-color: var(--body-bgcolor, #fff);
  }
  .brands-directory-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 40px;
  }
  .brands-directory-title {
    font-size: 36px;
    margin-bottom: 12px;
    color: var(--heading_text_color);
  }
  .brands-directory-description {
    color: var(--para_text_color);
    font-size: 16px;
  }

  .featured-brands {
    margin-bottom: 48px;
  }
  .featured-brands-title {
    font-size: 24px;
    margin-bottom: 24px;
    text-align: center;
  }
  .featured-brands-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
  }
  .featured-brand-card {
    background: #fff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }
  .featured-brand-image img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }
  .featured-brand-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .featured-brand-name {
    font-size: 20px;
    margin: 0;
  }
  .featured-brand-subtitle {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color_secondary);
    margin: 0;
  }
  .featured-brand-description {
    margin: 0;
    color: var(--para_text_color);
    font-size: 15px;
  }
  .brand-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 18px;
    background-color: var(--color_primary);
    color: #000;
    border-radius: 999px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .brand-button:hover {
    opacity: 0.85;
  }

  .brands-directory-body {
    background: #fff;
    border-radius: 24px;
    padding: 32px;
    box-shadow: 0 20px 45px rgba(0,0,0,0.05);
  }
  .brand-index {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    padding-bottom: 24px;
    margin-bottom: 32px;
  }
  .brand-index-label {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .brand-index-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .brand-index-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid rgba(0,0,0,0.12);
    color: var(--color_secondary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.2s ease;
  }
  .brand-index-link:hover {
    background-color: var(--color_primary);
    border-color: var(--color_primary);
    color: #000;
  }

  .brand-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 32px;
  }
  .brand-group-title {
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 14px;
  }
  .brand-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .brand-item a {
    color: var(--color_secondary);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .brand-item a::before {
    content: '\25CF';
    font-size: 6px;
  }
  .brand-item a:hover {
    color: var(--color_primary);
  }

  .brands-directory-empty {
    text-align: center;
    color: var(--para_text_color);
    font-size: 16px;
  }

  @media (max-width: 991px) {
    .brands-directory-title {
      font-size: 30px;
    }
    .brands-directory-body {
      padding: 24px;
    }
  }
  @media (max-width: 767px) {
    .brands-directory {
      padding-top: 40px;
      padding-bottom: 40px;
    }
    .brands-directory-body {
      padding: 20px;
    }
    .brand-groups {
      grid-template-columns: 1fr;
    }
    .brand-index {
      flex-direction: column;
      align-items: flex-start;
    }
    .brand-index-links {
      justify-content: flex-start;
    }
  }
</style>

